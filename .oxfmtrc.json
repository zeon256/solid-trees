{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "proseWrap": "always",
  "experimentalSortImports": {
    "groups": [
      ["value-builtin", "value-external", "type-builtin", "type-external"],
      [
        "value-internal",
        "type-internal",
        "value-parent",
        "type-parent",
        "value-sibling",
        "type-sibling",
        "value-index",
        "type-index"
      ],
      "unknown"
    ],
    "ignoreCase": true,
    "newlinesBetween": true,
    "order": "asc"
  },
  "ignorePatterns": ["node_modules", "dist", "pnpm-lock.yaml", "*.json"]
}
