/solid-api#31","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#reading-tree-state-from-solid","content":"Model getters track inside Solid scopes and always return current values\nimperatively. Read them directly in JSX, or derive values through the primitives\nbelow. Solid code writes back through model methods."},"536":{"id":"/docs/reference/solid-api#32","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#reading-tree-state-from-solid","content":"Common read patterns include:"},"537":{"id":"/docs/reference/solid-api#33","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#reading-tree-state-from-solid","content":"selected paths for sibling panels or action bars"},"538":{"id":"/docs/reference/solid-api#34","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#reading-tree-state-from-solid","content":"search state for search inputs and result counts"},"539":{"id":"/docs/reference/solid-api#35","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#reading-tree-state-from-solid","content":"custom derived values such as \"is this path focused?\""},"540":{"id":"/docs/reference/solid-api#36","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#primitives","content":"`createFileTreeSelector(model, selector, isEqual?)`"},"541":{"id":"/docs/reference/solid-api#37","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#primitives","content":"generic bridge from the model into a Solid memo"},"542":{"id":"/docs/reference/solid-api#38","page_id":"/docs/reference/solid-api","tags":[],"type":"text","url":"/docs/reference/solid-api#primitives","content":"returns an accessor for a value selected from the current model"},"543":{"id":"/docs/reference/solid-api#39","page_id":"/docs/reference/so